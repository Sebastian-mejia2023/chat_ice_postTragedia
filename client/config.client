# Configuracion del Cliente ZeroC Ice
# Mapeo Slice -> Java para deserializar excepciones de negocio (Chat::X -> co.icesi.Chat.X)
Ice.Package.Chat=co.icesi

Chat.Server.Host=127.0.0.1
Chat.Server.Port=10000

# Limite de mensaje Ice por defecto (1024 KB - NO modificar para cumplir chunking)
Ice.MessageSizeMax=1024

# Timeouts y reintentos de conexion
Ice.Override.ConnectTimeout=5000
Ice.Override.Timeout=10000

# Configuracion de adaptadores del cliente
ClientAdapter.Endpoints=tcp -h 127.0.0.1
